digraph pipeline {
    graph [
        rankdir=LR
        bgcolor="white"
        fontname="Helvetica,Arial,sans-serif"
        pad=0.6
        nodesep=0.5
        ranksep=1.3
        dpi=140
        size="12,7!"
        splines=polyline
    ]

    node [
        fontname="Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        width=1.9
        penwidth=1.5
        margin="0.14,0.1"
    ]

    edge [
        fontname="Helvetica,Arial,sans-serif"
        fontsize=8
        color="#888780"
        penwidth=1.5
        arrowsize=0.75
        arrowhead=normal
    ]

    // ── Column ordering ──────────────────────────────────
    {rank=same; lidar; chassis; joystick}
    {rank=same; peripherals; controller}
    {rank=same; slam}
    {rank=same; map_saver; rviz}
    {rank=same; saved_map; live_map; motion}

    // Invisible vertical-ordering edges within each column
    joystick -> lidar    [style=invis weight=10]
    lidar    -> chassis  [style=invis weight=10]
    peripherals -> controller [style=invis weight=10]
    map_saver -> rviz    [style=invis weight=10]
    saved_map -> live_map -> motion [style=invis weight=10]

    // ── INPUT nodes (teal green) ─────────────────────────
    lidar [
        label=<<b>LiDAR</b><br align="center"/><font point-size="9" color="#0F6E56">/scan · LaserScan</font>>
        fillcolor="#E1F5EE" color="#1D9E75" fontcolor="#085041"
        height=0.65
    ]
    chassis [
        label=<<b>JetRover Chassis</b><br align="center"/><font point-size="9" color="#0F6E56">wheel encoders + IMU</font>>
        fillcolor="#E1F5EE" color="#1D9E75" fontcolor="#085041"
        height=0.65
    ]
    joystick [
        label=<<b>Joystick Controller</b><br align="center"/><font point-size="9" color="#0F6E56">gamepad input</font>>
        fillcolor="#E1F5EE" color="#1D9E75" fontcolor="#085041"
        height=0.65
    ]

    // ── VENDOR PACKAGE nodes (purple) ────────────────────
    peripherals [
        label=<<b>peripherals</b><br align="center"/><font point-size="9" color="#3C3489">LiDAR driver · joystick_control · vendor pkg</font>>
        fillcolor="#EEEDFE" color="#534AB7" fontcolor="#26215C"
        height=0.65
    ]
    controller [
        label=<<b>controller</b><br align="center"/><font point-size="9" color="#3C3489">EKF: wheel + IMU → /odom + TF<br align="center"/>motor drive · vendor pkg</font>>
        fillcolor="#EEEDFE" color="#534AB7" fontcolor="#26215C"
        height=0.9
    ]

    // ── SLAM node (blue) ─────────────────────────────────
    slam [
        label=<<b>SLAM node</b><br align="center"/><font point-size="10" color="#0C447C">slam_toolbox</font><br align="center"/><font point-size="9" color="#0C447C"><i>tune params</i></font>>
        fillcolor="#E6F1FB" color="#185FA5" fontcolor="#042C53"
        width=2.1
        height=1.4
    ]

    // ── TOOL nodes (salmon/red) ──────────────────────────
    map_saver [
        label=<<b>map_saver_cli</b><br align="center"/><font point-size="9" color="#712B13">saves map on demand</font>>
        fillcolor="#FAECE7" color="#993C1D" fontcolor="#4A1B0C"
        height=0.65
    ]
    rviz [
        label=<<b>RViz2</b><br align="center"/><font point-size="9" color="#712B13">live visualisation</font>>
        fillcolor="#FAECE7" color="#993C1D" fontcolor="#4A1B0C"
        height=0.65
    ]

    // ── OUTPUT nodes (green) ─────────────────────────────
    saved_map [
        label=<<b>Saved map</b><br align="center"/><font point-size="9" color="#27500A">room.pgm + room.yaml</font>>
        fillcolor="#EAF3DE" color="#3B6D11" fontcolor="#173404"
        height=0.65
    ]
    live_map [
        label=<<b>Live map</b><br align="center"/><font point-size="9" color="#27500A">/map · OccupancyGrid</font>>
        fillcolor="#EAF3DE" color="#3B6D11" fontcolor="#173404"
        height=0.65
    ]
    motion [
        label=<<b>Robot motion</b><br align="center"/><font point-size="9" color="#27500A">Mecanum drive</font>>
        fillcolor="#EAF3DE" color="#3B6D11" fontcolor="#173404"
        height=0.65
    ]

    // ── Edges ────────────────────────────────────────────
    lidar       -> peripherals  []
    chassis     -> controller   []
    joystick    -> peripherals  []
    peripherals -> slam         [label="  /scan"]
    controller  -> slam         [label="  /odom + TF"]
    slam        -> map_saver    [label="  /map"]
    slam        -> rviz         [label="  /map"]
    map_saver   -> saved_map    []
    rviz        -> live_map     []
    peripherals -> controller   [label="  controller/cmd_vel"]
    controller  -> motion       []
}
