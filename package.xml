<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>two_d_lidar_mapping_with_slam</name>
  <version>1.0.0</version>
  <description>JetRover 2-D SLAM integration with C++ LiDAR health diagnostics and XML launch</description>
  <maintainer email="mahersabbagh80@gmail.com">Maher Alshirazi Alsabbagh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <!-- HiWonder packages — pre-installed on Jetson, runtime only -->
  <exec_depend>controller</exec_depend>
  <exec_depend>peripherals</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>ros2launch</test_depend>
  <test_depend>ros2topic</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
