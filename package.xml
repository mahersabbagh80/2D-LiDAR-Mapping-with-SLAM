<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>two_d_lidar_mapping_with_slam</name>
  <version>1.0.0</version>
  <description>Teleoperated 2-D occupancy-grid mapping with a JetRover, ROS 2, LiDAR, and SLAM</description>
  <maintainer email="mahersabbagh80@gmail.com">Maher Alshirazi Alsabbagh</maintainer>
  <license>Apache-2.0</license>

  <!-- Community packages — must be installed on Jetson -->
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Robot URDF — sibling package in this workspace -->
  <exec_depend>jetrover_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <!-- HiWonder packages — pre-installed on Jetson, runtime only -->
  <exec_depend>controller</exec_depend>
  <exec_depend>peripherals</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
